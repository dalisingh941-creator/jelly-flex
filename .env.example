# JellyFlex 2.0 Environment Configuration Template
# All secrets are hardware-locked locally with PBKDF2HMAC + Fernet

# Optional custom salt pepper (defaults to machine UUID derivation if empty)
JELLYFLEX_MASTER_PEPPER=jellyflex-local-default-salt

# BYOK AI Model Keys (Can also be configured securely in-app via BYOK Vault Modal)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Port Bindings
FASTAPI_PORT=8000
FRONTEND_PORT=3000
